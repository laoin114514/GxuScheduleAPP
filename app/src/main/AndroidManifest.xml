<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WakeupSchedule"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="GoogleAppIndexingWarning">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />

        <!-- 其他Activity声明 -->
        <activity android:name=".ScheduleActivity" />
        <activity android:name=".AddCourseActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".WebViewActivity" />
        <activity android:name=".SchoolImportActivity" />
        <activity android:name=".SchoolListActivity" />
        <activity android:name=".TimeTableEditActivity" />
        <activity android:name=".ApplyAdapterActivity" />
        <activity android:name=".PermissionGuideActivity" />
        <activity android:name=".IntroActivity" />
        <activity android:name=".AboutActivity" />
        <activity android:name=".CourseOverviewActivity" />

        <activity android:name=".BindJwxtActivity" />
        <activity android:name=".ProfileActivity" />

        <!-- 闹钟接收器 -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".service.DailyAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".service.AutoStartReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 桌面小部件 - 今日课程 -->
        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="true"
            android:label="今日课程">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="com.cherry.wakeupschedule.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- 桌面小部件 - 极简小组件 -->
        <receiver
            android:name=".widget.MinimalWidgetProvider"
            android:exported="true"
            android:label="下课倒计时">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="com.cherry.wakeupschedule.widget.minimal.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_minimal_info" />
        </receiver>

        <!-- 桌面小部件 - 近日课程 -->
        <receiver
            android:name=".widget.UpcomingDaysWidgetProvider"
            android:exported="true"
            android:label="近日课程">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="com.cherry.wakeupschedule.widget.upcoming.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_days_info" />
        </receiver>

        <!-- 桌面小部件 - 一周课程（已禁用）
        <receiver
            android:name=".widget.WeekViewWidgetProvider"
            android:exported="true"
            android:label="一周课程">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="com.cherry.wakeupschedule.widget.weekview.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_view_info" />
        </receiver> -->

        <!-- 一周课程周期性更新接收器（已禁用）
        <receiver
            android:name=".widget.WeekViewPeriodicReceiver"
            android:exported="false" />
         -->

        <!-- 小组件定时更新接收器 -->
        <receiver
            android:name=".widget.WidgetUpdateReceiver"
            android:exported="false" />

        <!-- 小组件启动接收器 -->
        <receiver
            android:name=".widget.WidgetBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 课程结束更新小组件接收器 -->
        <receiver
            android:name=".widget.WidgetCourseEndReceiver"
            android:exported="false" />

        <!-- 小组件定期更新接收器 -->
        <receiver
            android:name=".widget.WidgetPeriodicUpdateReceiver"
            android:exported="false" />

        <!-- Minimal小组件定期更新接收器 -->
        <receiver
            android:name=".widget.MinimalWidgetPeriodicReceiver"
            android:exported="false" />

        <!-- Minimal小组件课程结束更新接收器 -->
        <receiver
            android:name=".widget.MinimalWidgetCourseEndReceiver"
            android:exported="false" />

        <!-- Minimal小组件短周期刷新接收器（API < 24 低版本保底） -->
        <receiver
            android:name=".widget.MinimalWidgetTickReceiver"
            android:exported="false" />

        <!-- Minimal小组件倒计时安全更新接收器 -->
        <receiver
            android:name=".widget.MinimalWidgetSafetyReceiver"
            android:exported="false" />

        <!-- 近日课程小组件周期性更新接收器 -->
        <receiver
            android:name=".widget.UpcomingDaysPeriodicReceiver"
            android:exported="false" />

        <!-- 一周课程小组件周期性更新接收器（已禁用）
        <receiver
            android:name=".widget.WeekViewPeriodicReceiver"
            android:exported="false" />
         -->

        <!-- 时间变化监听接收器 -->
        <receiver
            android:name=".widget.WidgetTimeChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 午夜更新接收器 -->
        <receiver
            android:name=".widget.WidgetMidnightReceiver"
            android:exported="false" />

        <!-- 课程提醒前台服务 -->
        <service
            android:name=".service.CourseReminderForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="course_reminder_keepalive_for_alarm_reliability" />
        </service>

        <!-- 小组件课程列表 RemoteViewsService（用于 ListView 数据加载）
             注意：必须 exported=true，系统应用需要绑定此 Service 加载数据，
             但通过 BIND_REMOTEVIEWS 权限保护，只允许系统调用 -->
        <service
            android:name=".widget.WidgetCourseListService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- FileProvider for file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>