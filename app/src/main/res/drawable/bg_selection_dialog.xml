<?xml version="1.0" encoding="utf-8"?>
<!-- 居中弹窗（StyledDialog / SelectionDialog / 成绩详情）底板。
     原来是 #E6FFFFFF —— 90% 白是半透明的，弹窗背后的课表菜单会透上来，
     出现"弹窗里还能看到菜单标题"的重影。改成不透明的主题 surface 容器色，
     深色模式由 values-night 的同名资源接管。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
</shape>
