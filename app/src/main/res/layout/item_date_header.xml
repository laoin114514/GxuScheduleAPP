<?xml version="1.0" encoding="utf-8"?>
<!--
  周课表日期栏：周几 + 日期，与课表网格同宽（32dp 时间轴占位列 + 7 个等分日列）。
  每个 ViewPager2 页面各带一份（见 WeekPagerAdapter.buildPageRoot），
  因此它和网格共用同一套横向滚动，左右滑周时天然 1:1 跟手。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Weekday row -->
    <LinearLayout
        android:id="@+id/header_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Offset column for time axis -->
        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_year_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="年"
                android:textSize="@dimen/text_label"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <TextView android:id="@+id/tv_weekday_1" style="@style/DateHeaderText"
            android:layout_weight="1" android:text="一" />
        <TextView android:id="@+id/tv_weekday_2" style="@style/DateHeaderText"
            android:layout_weight="1" android:text="二" />
        <TextView android:id="@+id/tv_weekday_3" style="@style/DateHeaderText"
            android:layout_weight="1" android:text="三" />
        <TextView android:id="@+id/tv_weekday_4" style="@style/DateHeaderText"
            android:layout_weight="1" android:text="四" />
        <TextView android:id="@+id/tv_weekday_5" style="@style/DateHeaderText"
            android:layout_weight="1" android:text="五" />
        <TextView android:id="@+id/tv_weekday_6" style="@style/DateHeaderText"
            android:layout_weight="1" android:text="六" />
        <TextView android:id="@+id/tv_weekday_7" style="@style/DateHeaderText"
            android:layout_weight="1" android:text="日" />

    </LinearLayout>

    <!-- Date number row -->
    <LinearLayout
        android:id="@+id/header_dates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <!-- Year in offset column -->
        <TextView
            android:id="@+id/tv_year_value"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="2026"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView android:id="@+id/tv_date_1" style="@style/DateNumberText"
            android:layout_weight="1" android:text="7/6" />
        <TextView android:id="@+id/tv_date_2" style="@style/DateNumberText"
            android:layout_weight="1" android:text="7/7" />
        <TextView android:id="@+id/tv_date_3" style="@style/DateNumberText"
            android:layout_weight="1" android:text="7/8" />
        <TextView android:id="@+id/tv_date_4" style="@style/DateNumberText"
            android:layout_weight="1" android:text="7/9" />
        <TextView android:id="@+id/tv_date_5" style="@style/DateNumberText"
            android:layout_weight="1" android:text="7/10" />
        <TextView android:id="@+id/tv_date_6" style="@style/DateNumberText"
            android:layout_weight="1" android:text="7/11" />
        <TextView android:id="@+id/tv_date_7" style="@style/DateNumberText"
            android:layout_weight="1" android:text="7/12" />

    </LinearLayout>

</LinearLayout>
