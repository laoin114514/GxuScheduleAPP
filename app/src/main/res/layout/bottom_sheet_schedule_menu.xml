<?xml version="1.0" encoding="utf-8"?>
<!--
  课表菜单底部弹层。

  版式约定（四组内容一个节奏）：
  拖拽条 → 居中标 + 副标（当前学期） → 分组标签 → 卡片 → 分组标签 → 卡片 → 分组标签 → 卡片。

  改动历史：
  1. 标题左对齐、三个蓝色分组标签像链接、学期色块裸浮没有容器 → 统一居中标题 + 低对比度分组标签 + 全部卡片化；
  2. 周数卡里「第 1 周 / 第 20 周」与滑块轨道端点对不齐（轨道被 thumbRadius 内缩）→ 合并成一行居中提示；
  3. 「课表外观」原是一行跳转入口，点开还要再弹一层半屏面板 → 现在整组控件直接内联在菜单里
     （见 view_schedule_appearance_controls.xml），改完即时生效，不用二次点开；
  4. 外观卡内部再排一遍：默认高度提示只在偏离默认值时贴着刻度显形、40/120 与轨道两端对齐、
     组间发丝线留 4dp 呼吸，卡片上下内边距对称。

  5. 「课表外观」改为折叠分组：标题行常驻（用户一眼知道有这个设置），点开才展开控件，
     展开状态记在设置里，下次打开菜单保持上次状态；展开不改变菜单高度，只在菜单内下滑查看。

  内容变长后整列放进 NestedScrollView：窗口高度不足时菜单内部滚动，
  拖拽条固定在顶部不跟着滚。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- 拖拽指示条：主题色 + 布局 alpha，深色底下也能看清 -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:alpha="0.32"
        android:background="@drawable/bg_drag_handle" />


    <!-- 标题区：钉在滚动区之上（不随内容滚走），右端是关闭按钮 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tv_menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/menu_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_menu_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭菜单"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>

    <!-- 副标题：当前学期，代码里按学期状态填写 -->
    <TextView
        android:id="@+id/tv_menu_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="@string/menu_semester_placeholder"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_caption" />

    <!-- 内联错误条：菜单内的失败（如切学期时联网拉课表失败）显示在这里，
         而不是 AppToast —— 弹层打开时 Toast 会被弹窗遮罩压住，用户看不到。 -->
    <TextView
        android:id="@+id/tv_menu_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_inline_error"
        android:drawablePadding="6dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="?attr/colorOnErrorContainer"
        android:textSize="@dimen/text_body_small"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_mtrl_error_outline"
        app:drawableTint="?attr/colorOnErrorContainer" />

    <!-- 滚动区：周次 / 学期 / 外观；右侧常驻细滚动条提示「下面还有」 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbarStyle="insideInset"
        android:scrollbarSize="3dp"
        android:scrollbarThumbVertical="?attr/colorOutlineVariant"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="28dp">



            <!-- ═══ 周次 ═══ -->
            <TextView
                style="@style/SheetSectionLabel"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/menu_section_week" />

            <com.google.android.material.card.MaterialCardView
                style="@style/DetailSheetCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <!-- 当前周 + 快捷回到本周（不在本周时才出现，见 ScheduleFragment.refreshWeekSlider） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_week_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/menu_week_placeholder"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_headline"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/ll_week_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- 周数滑块：外观见 @style/AppSlider（与字体大小页共用同一套样式）。
                         保留 M3 的 withinBounds 气泡：拖动时手指正压着轨道，
                         上方的大号「第 N 周」会被挡住，气泡是唯一能读到的即时反馈。 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sb_week"
                        style="@style/AppSlider"
                        android:layout_marginTop="4dp"
                        android:valueFrom="1"
                        android:valueTo="20"
                        android:stepSize="1"
                        android:value="1"
                        app:labelBehavior="withinBounds" />

                    <TextView
                        android:id="@+id/tv_week_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/menu_week_hint_placeholder"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 学期 ═══
                 未绑定教务时整组隐藏（学期表和色块都为空，留一张空卡片比不显示更奇怪） -->
            <LinearLayout
                android:id="@+id/group_semester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SheetSectionLabel"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/menu_section_semester" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/DetailSheetCard">

                    <HorizontalScrollView
                        android:id="@+id/hsv_semester"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/ll_semester_list"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingEnd="4dp"
                            android:paddingBottom="1dp" />
                    </HorizontalScrollView>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ═══ 外观 ═══
                 折叠分组：标题行常驻（用户一眼知道有外观设置），点开才展开控件；
                 展开状态由 SettingsManager 持久化，下次打开菜单保持上次状态。
                 控件一卡三组，顺序按改动粒度排——格子本身 → 格子的边。 -->
            <LinearLayout
                android:id="@+id/group_schedule_appearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_appearance_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        style="@style/SheetSectionLabel"
                        android:text="@string/menu_section_appearance" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/iv_appearance_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_expand_more"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@string/menu_section_appearance" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_schedule_appearance_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include layout="@layout/view_schedule_appearance_controls" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
