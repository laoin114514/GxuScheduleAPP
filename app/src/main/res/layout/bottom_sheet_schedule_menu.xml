<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- 拖拽指示条 -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="课表菜单"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="20dp" />

    <!-- ═══ 周数选择 ═══ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="周数选择"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/ScheduleSectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardElevation="0dp"
        app:contentPadding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_week_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="第 1 周"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tv_week_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拖动选择"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Material 3 滑块：宽胶囊轨道 + 白色圆球在轨道内滑动。
                 M3 默认手柄是 4dp×44dp 的竖条，必须显式把 thumbWidth/thumbHeight
                 设为相等并配 thumbRadius，才能得到圆形滚球。 -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sb_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="20"
                android:stepSize="1"
                android:value="1"
                app:labelBehavior="withinBounds"
                app:thumbColor="#FFFFFF"
                app:thumbWidth="18dp"
                app:thumbHeight="18dp"
                app:thumbRadius="9dp"
                app:thumbStrokeColor="?attr/colorPrimary"
                app:thumbStrokeWidth="2dp"
                app:thumbElevation="4dp"
                app:trackColorActive="?attr/colorPrimary"
                app:trackColorInactive="?attr/colorOutlineVariant"
                app:trackHeight="20dp" />

            <!-- 起止周数标注 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_week_min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="第1周"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_week_max"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="第20周"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ 分割线 ═══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginBottom="20dp" />

    <!-- ═══ 学期选择 ═══ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="学期选择"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:id="@+id/hsv_semester"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/ll_semester_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="20dp" />

    </HorizontalScrollView>

</LinearLayout>
