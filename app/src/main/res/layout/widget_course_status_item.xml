<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程概览的状态卡片行（官网「今日课程概览组件」样式）：
     「{HH:mm} {课名}」+ 右侧状态徽标，下行「{教室} · {起-止}节」。
     背景由 Factory 按 状态 setBackgroundResource 切换，RemoteViews 每次全量应用，无复用脏状态。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/course_status_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_row_upcoming"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/course_status_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="@dimen/text_caption"
            android:textColor="@color/widget_text_title"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/course_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textSize="@dimen/text_micro"
            android:textColor="@color/widget_badge_upcoming" />
    </LinearLayout>

    <TextView
        android:id="@+id/course_status_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textSize="@dimen/text_label"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
