<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="24dp" />

        <!-- 账号 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScheduleSectionCard"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="账号" />

                <!-- 未绑定状态：绑定教务 -->
                <LinearLayout android:id="@+id/item_bind_jwxt"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_link"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="绑定教务"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="广西大学教务系统"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- 已绑定状态：账号信息展示 -->
                <LinearLayout android:id="@+id/item_account_info"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:visibility="gone">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_link"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:id="@+id/tv_account_name"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=""
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:id="@+id/tv_account_id"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=""
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 个人信息（仅已绑定时可点击） -->
                <LinearLayout android:id="@+id/item_profile"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_badge"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="个人信息"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- 解绑按钮（仅已绑定时显示） -->
                <TextView
                    android:id="@+id/btn_unbind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="解绑教务账号"
                    android:textSize="14sp"
                    android:textColor="?attr/colorError"
                    android:padding="12dp"
                    android:gravity="center"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 学期 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScheduleSectionCard"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="学期" />

                <LinearLayout android:id="@+id/item_semester"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_school"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:id="@+id/tv_semester_label"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="当前学期"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:id="@+id/tv_semester_value"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="2024-2025学年 第一学期"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout android:id="@+id/item_week"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_today"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:id="@+id/tv_week_label"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="默认周次"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:id="@+id/tv_week_value"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="第5周"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- 学期日期范围 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_date_range"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:id="@+id/tv_semester_date_range"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="未获取"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- 学期总周数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_schedule"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:id="@+id/tv_total_weeks"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="20周"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>


            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 课表 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScheduleSectionCard"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="主题" />

                <LinearLayout android:id="@+id/item_theme_palette"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_palette"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="主题色板"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="经典紫"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- 外观（主题模式） -->
                <LinearLayout android:id="@+id/item_theme_mode"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_opacity"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="外观"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:id="@+id/tv_theme_mode_value"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="跟随系统"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 提醒 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScheduleSectionCard"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="提醒" />

                <LinearLayout android:id="@+id/item_alarm"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_notifications"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="课前提醒"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout android:id="@+id/item_time_table"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_schedule"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="时间表设置"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 关于 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScheduleSectionCard"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="关于" />

                <LinearLayout android:id="@+id/item_about"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_info"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="关于应用"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout android:id="@+id/item_feedback"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_feedback"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="反馈建议"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
