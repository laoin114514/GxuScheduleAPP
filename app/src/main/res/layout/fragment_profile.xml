<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_gradient">

    <!-- 顶栏：与工具页同款居中主色标题 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/profile_title"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- ═══ 账号 ═══ -->
            <TextView style="@style/AppSectionHeader"
                android:paddingTop="10dp"
                android:text="@string/profile_section_account" />

            <com.google.android.material.card.MaterialCardView style="@style/AppSectionCard">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">

                    <!-- 未绑定状态：绑定教务 -->
                    <LinearLayout android:id="@+id/item_bind_jwxt"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_link"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_bind_jwxt"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_bind_jwxt_sub"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!-- 已绑定状态：账号信息展示 -->
                    <LinearLayout android:id="@+id/item_account_info"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:visibility="gone">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_person"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:id="@+id/tv_account_name"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=""
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:id="@+id/tv_account_id"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=""
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_account"
                            style="@style/Widget.Material3.Button.TextButton.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:minHeight="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/profile_update_password"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_body_small"
                            android:contentDescription="更新登录密码"
                            app:icon="@drawable/ic_edit"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:iconTint="?attr/colorPrimary" />

                    </LinearLayout>

                    <!-- 个人信息（仅已绑定时可点击） -->
                    <LinearLayout android:id="@+id/item_profile"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_badge"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:text="@string/profile_personal_info"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!-- 解绑按钮（仅已绑定时显示） -->
                    <TextView
                        android:id="@+id/btn_unbind"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_unbind"
                        android:textSize="@dimen/text_body_small"
                        android:textColor="@color/danger_color"
                        android:padding="12dp"
                        android:gravity="center"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 学期 ═══ -->
            <TextView style="@style/AppSectionHeader" android:text="@string/profile_section_semester" />

            <com.google.android.material.card.MaterialCardView style="@style/AppSectionCard">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:id="@+id/item_semester"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_school"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_current_semester"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:id="@+id/tv_semester_value"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/common_not_set"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!-- 学期日期范围（信息行） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_date_range"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_semester_range"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:id="@+id/tv_semester_date_range"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_semester_range_hint"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- 学期总周数（信息行） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="16dp">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_view_week"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_semester_weeks"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:id="@+id/tv_total_weeks"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="—"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 外观 ═══ -->
            <TextView style="@style/AppSectionHeader" android:text="@string/profile_section_appearance" />

            <com.google.android.material.card.MaterialCardView style="@style/AppSectionCard">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">

                    <!-- 主题（深浅色模式） -->
                    <LinearLayout android:id="@+id/item_theme_mode"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_opacity"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_theme"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:id="@+id/tv_theme_mode_value"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_theme_follow_system"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!-- 课表（课表外观与样式） -->
                    <LinearLayout android:id="@+id/item_schedule_appearance"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_grid_view"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_schedule_appearance"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:id="@+id/tv_schedule_cell_height_value"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_schedule_appearance_sub"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!-- 字体大小（整体 UI 缩放档位） -->
                    <LinearLayout android:id="@+id/item_font_size"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_format_size"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_font_size"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:id="@+id/tv_font_size_value"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_font_size_standard"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 通用 ═══ -->
            <TextView style="@style/AppSectionHeader" android:text="@string/profile_section_general" />

            <com.google.android.material.card.MaterialCardView style="@style/AppSectionCard">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:id="@+id/item_time_table"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_schedule"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:text="@string/profile_timetable_settings"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <LinearLayout android:id="@+id/item_widget"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_widgets"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_widgets"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/profile_widgets_sub"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ 关于 ═══ -->
            <TextView style="@style/AppSectionHeader" android:text="@string/profile_section_about" />

            <com.google.android.material.card.MaterialCardView style="@style/AppSectionCard">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:id="@+id/item_about"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_info"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:text="@string/profile_about_app"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView android:id="@+id/dot_update_hint" android:layout_width="8dp"
                            android:layout_height="8dp" android:layout_marginEnd="10dp"
                            android:src="@drawable/dot_update_hint"
                            android:visibility="gone" />

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <LinearLayout android:id="@+id/item_feedback"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">

                        <FrameLayout android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mtrl_feedback"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp"
                            android:text="@string/profile_feedback"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_mtrl_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
