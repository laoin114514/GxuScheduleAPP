<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="24dp" />

        <!-- 账号 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ProfileSection"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="账号" />

                <LinearLayout android:id="@+id/item_bind_jwxt"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_link"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="绑定教务"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="广西大学教务系统"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout android:id="@+id/item_profile"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_badge"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="个人信息"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 学期 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ProfileSection"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="学期" />

                <LinearLayout android:id="@+id/item_semester"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_school"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:id="@+id/tv_semester_label"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="当前学期"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:id="@+id/tv_semester_value"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="2024-2025学年 第一学期"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout android:id="@+id/item_week"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_today"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:id="@+id/tv_week_label"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="默认周次"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:id="@+id/tv_week_value"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="第5周"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 课表 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ProfileSection"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="课表" />

                <LinearLayout android:id="@+id/item_theme_palette"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_palette"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="主题色板"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="经典紫"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 提醒 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ProfileSection"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="提醒" />

                <LinearLayout android:id="@+id/item_alarm"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_notifications"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="课前提醒"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout android:id="@+id/item_time_table"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_schedule"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="时间表设置"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 数据 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ProfileSection"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="数据" />

                <LinearLayout android:id="@+id/item_import"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_file_download"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="导入课程"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout android:id="@+id/item_export"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_file_upload"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="导出课程"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 关于 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ProfileSection"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">

                <TextView style="@style/SectionTitle" android:text="关于" />

                <LinearLayout android:id="@+id/item_about"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_info"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="关于应用"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout android:id="@+id/item_feedback"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_mtrl_feedback"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp"
                        android:text="反馈建议"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_mtrl_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
