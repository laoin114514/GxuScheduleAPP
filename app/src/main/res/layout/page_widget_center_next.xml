<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件中心 · 第 5 页「下一门课提醒 4×2」 -->
<com.cherry.wakeupschedule.ui.widget.VerticalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView style="@style/AppSectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="下一门课提醒"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4×2"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="下节课的时间地点与开课倒计时。"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:layout_marginTop="12dp">

                    <include
                        android:id="@+id/preview_widget"
                        layout="@layout/widget_next_course_preview" />

                </FrameLayout>

                <include
                    android:id="@+id/footer_add"
                    layout="@layout/widget_center_add_footer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.cherry.wakeupschedule.ui.widget.VerticalScrollView>
