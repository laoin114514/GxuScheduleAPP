<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程概览的静态假数据预览：小组件选择器（previewLayout）与「小组件中心」页共用。
     三行分别演示「已上完（灰）/ 进行中（绿）/ 下一节（红）」，配色与真身同源：
     彩色行取课表页课程色（蓝/红/绿）+ 白字，已上完整行连文字一起灰掉。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="10dp">

    <!-- 头部：左固定标签 + 右周X（与 4×2 变体同构） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日课程 · 3 门"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="周三"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/widget_row_finished"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="08:00 软件工程"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/widget_status_finished_text"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="已上完"
                    android:textSize="@dimen/text_micro"
                    android:textColor="@color/widget_status_finished_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="君武 301 · 1-2节"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_status_finished_text_weak"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:background="@drawable/widget_row_active"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10:10 大学物理"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/widget_status_text"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="进行中"
                    android:textSize="@dimen/text_micro"
                    android:textColor="@color/widget_status_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="物理楼 302 · 3-4节"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_status_text_weak"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:background="@drawable/widget_row_next"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="14:30 大学英语"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/widget_status_text"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="下一节"
                    android:textSize="@dimen/text_micro"
                    android:textColor="@color/widget_status_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="外国语 204 · 5-6节"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_status_text_weak"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
