<?xml version="1.0" encoding="utf-8"?>
<!--
  发现新版本弹窗（由 StyledDialog 的 fl_custom 槽位承载，标题走 builder）。

  原来的问题：WebView 固定 350dp 高，可更新说明往往只有一两行，
  弹窗里于是出现一大片空白；三个按钮是 8dp 内边距的裸 TextView（约 34dp 高），
  标题还是左对齐 20sp，与全 App 其它弹窗（居中 18sp）不是一套。

  现在：说明区高度由内容决定（最小 120dp / 最大 320dp，代码里按 scrollHeight 量），
  按钮统一 ≥48dp，「立即更新」用主色胶囊。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingHorizontal="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_version_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:textSize="@dimen/text_caption"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- 更新说明：高度在代码里按实际内容量（120–320dp 之间） -->
    <WebView
        android:id="@+id/webview_notes"
        android:layout_width="match_parent"
        android:layout_height="160dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="下载后自动校验并引导安装"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_caption" />

    <!-- 底部按钮：跳过此版本 | 稍后 | 立即更新（主操作在右） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_skip_version"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="8dp"
            android:text="跳过此版本"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/btn_later"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            android:text="稍后"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body_small" />

        <TextView
            android:id="@+id/btn_update_now"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_primary_pill"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingHorizontal="20dp"
            android:text="立即更新"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
