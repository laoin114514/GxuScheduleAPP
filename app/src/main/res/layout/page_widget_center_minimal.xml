<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件中心 · 第 1 页「下课倒计时 2×2」 -->
<com.cherry.wakeupschedule.ui.widget.VerticalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 页头：标题与总述不进卡片，与其他页同构 -->
        <TextView
            style="@style/AppSectionHeader"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:text="下课倒计时" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="正在上的课与距下课秒级倒计时，深浅色自适应。"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            style="@style/AppSectionCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2×2"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <FrameLayout
                    android:layout_width="172dp"
                    android:layout_height="172dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <include
                        android:id="@+id/preview_widget"
                        layout="@layout/widget_minimal_preview" />

                </FrameLayout>

                <include
                    android:id="@+id/footer_add"
                    layout="@layout/widget_center_add_footer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.cherry.wakeupschedule.ui.widget.VerticalScrollView>
