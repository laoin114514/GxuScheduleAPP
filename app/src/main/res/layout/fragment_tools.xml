<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：搜索 · 标题 · 头像 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <ImageButton
                android:id="@+id/btn_tools_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="搜索工具"
                android:src="@drawable/ic_mtrl_search"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="工具"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <FrameLayout
                android:id="@+id/btn_tools_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_tools_avatar"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="我的">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mtrl_person"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>
        </FrameLayout>

        <!-- 搜索框 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_tools_search">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_mtrl_search"
                app:tint="?attr/colorOutline" />

            <EditText
                android:id="@+id/et_tools_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="12dp"
                android:background="@null"
                android:hint="搜索工具…"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOutline"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- 内容列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_tools"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

    </LinearLayout>

    <!-- 搜索无结果空状态 -->
    <LinearLayout
        android:id="@+id/layout_tools_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_page_gradient"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.3"
            android:src="@drawable/ic_mtrl_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="未找到相关工具"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</FrameLayout>
