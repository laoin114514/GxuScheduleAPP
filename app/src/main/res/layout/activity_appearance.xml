<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_gradient">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurfaceVariant" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 主题标题 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="主题"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="12dp" />

            <!-- 浅色 / 深色 并排预览卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <include
                    android:id="@+id/card_light"
                    layout="@layout/item_appearance_preview_card" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/card_dark"
                    layout="@layout/item_appearance_preview_card" />
            </LinearLayout>

            <!-- 自动切换卡片 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ScheduleSectionCard"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 自动切换开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="自动切换"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface" />

                        <Switch
                            android:id="@+id/switch_auto_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:theme="@style/SwitchTheme" />
                    </LinearLayout>

                    <!-- 自动切换方式入口（开启后显示） -->
                    <LinearLayout
                        android:id="@+id/ll_auto_switch_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="自动切换方式"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tv_auto_switch_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="跟随系统"
                            android:textSize="14sp"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginEnd="4dp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="展开"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <!-- 自定时间选项（选择自定时间后显示） -->
                    <LinearLayout
                        android:id="@+id/ll_custom_times"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp" />

                        <!-- 深色时间 -->
                        <LinearLayout
                            android:id="@+id/row_dark_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="深色时间"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tv_dark_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18:00"
                                android:textSize="14sp"
                                android:textColor="?attr/colorPrimary"
                                android:layout_marginEnd="4dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_arrow_right"
                                android:contentDescription="选择时间"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 浅色时间 -->
                        <LinearLayout
                            android:id="@+id/row_light_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="浅色时间"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tv_light_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="07:00"
                                android:textSize="14sp"
                                android:textColor="?attr/colorPrimary"
                                android:layout_marginEnd="4dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_arrow_right"
                                android:contentDescription="选择时间"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 深色时段提示 -->
                        <TextView
                            android:id="@+id/tv_dark_period_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="深色时段：18:00 — 次日07:00"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
