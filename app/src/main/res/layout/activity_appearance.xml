<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_gradient">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurfaceVariant" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_margin">

            <!-- 浅色 / 深色 并排预览卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <include
                    android:id="@+id/card_light"
                    layout="@layout/item_appearance_preview_card" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/card_dark"
                    layout="@layout/item_appearance_preview_card" />
            </LinearLayout>

            <!-- 配色方案：5 套调色板（紫/蓝/青绿/暖棕/玫红）的入口。
                 之前 ThemeManager 里有 5 套 overlay、10 份配色数据，却没有任何 UI 能选，
                 等于永远只能用默认的海洋蓝。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    style="@style/AppSectionHeader"
                    android:paddingStart="4dp"
                    android:paddingTop="0dp"
                    android:text="@string/appearance_palette_section" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/AppSectionCard"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/ll_palette_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 自动切换卡片 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/AppSectionCard"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 自动切换开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/appearance_auto_switch"
                            android:textSize="@dimen/text_subtitle"
                            android:textColor="?attr/colorOnSurface" />

                        <Switch
                            android:id="@+id/switch_auto_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:theme="@style/SwitchTheme" />
                    </LinearLayout>

                    <!-- 自动切换方式入口（开启后显示） -->
                    <LinearLayout
                        android:id="@+id/ll_auto_switch_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/appearance_auto_switch_mode"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tv_auto_switch_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/appearance_auto_follow_system"
                            android:textSize="@dimen/text_body_small"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginEnd="4dp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="展开"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <!-- 自定时间选项（选择自定时间后显示） -->
                    <LinearLayout
                        android:id="@+id/ll_custom_times"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp" />

                        <!-- 深色时间 -->
                        <LinearLayout
                            android:id="@+id/row_dark_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/appearance_dark_time"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tv_dark_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/appearance_dark_time_placeholder"
                                android:textSize="@dimen/text_body_small"
                                android:textColor="?attr/colorPrimary"
                                android:layout_marginEnd="4dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_arrow_right"
                                android:contentDescription="选择时间"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 浅色时间 -->
                        <LinearLayout
                            android:id="@+id/row_light_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/appearance_light_time"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tv_light_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/appearance_light_time_placeholder"
                                android:textSize="@dimen/text_body_small"
                                android:textColor="?attr/colorPrimary"
                                android:layout_marginEnd="4dp" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_arrow_right"
                                android:contentDescription="选择时间"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 深色时段提示 -->
                        <TextView
                            android:id="@+id/tv_dark_period_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/appearance_dark_period_placeholder"
                            android:textSize="@dimen/text_caption"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
