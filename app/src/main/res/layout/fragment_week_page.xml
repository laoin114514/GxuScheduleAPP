<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 左侧时间轴 -->
        <LinearLayout
            android:id="@+id/time_axis"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <!-- 右侧课表内容区 -->
        <FrameLayout
            android:id="@+id/content_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Canvas 虚线网格背景，替代原来的 84+ 个 cell View -->
            <com.cherry.wakeupschedule.ui.widget.GridBackgroundView
                android:id="@+id/grid_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 课程卡片容器，手动定位 -->
            <FrameLayout
                android:id="@+id/course_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <!-- 空状态 -->
            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_mtrl_calendar_month"
                    android:alpha="0.3"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="暂无课程"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</ScrollView>
