<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_schedule_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Header bar: date + week info -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_week_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第5周 (本周)"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2026/7/28"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text=""
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <com.cherry.wakeupschedule.ui.widget.CircleIconButton
                android:id="@+id/btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_mtrl_refresh"
                android:contentDescription="刷新课表">

                <!-- 刷新中的小转圈（覆盖在刷新图标上） -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_refresh"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="?attr/colorPrimary"
                    app:indicatorSize="20dp"
                    app:trackThickness="2dp" />
            </com.cherry.wakeupschedule.ui.widget.CircleIconButton>

            <com.cherry.wakeupschedule.ui.widget.CircleIconButton
                android:id="@+id/btn_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_mtrl_menu"
                android:contentDescription="课表菜单" />

        </LinearLayout>

        <!-- 日期栏不在这里：它随页面横向滚动，所以放在每个 ViewPager2 页面内部，
             见 item_date_header.xml / WeekPagerAdapter.buildPageRoot -->

        <!-- ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <!-- 总课表：顶部类型筛选 + 当前学期全部课程按课程名归并后的纵向列表（与周课表互斥显示） -->
        <LinearLayout
            android:id="@+id/layout_overview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 全部 / 理论课 / 实践课：chip 由 ScheduleFragment 用 createAppChip 填充 -->
            <LinearLayout
                android:id="@+id/ll_overview_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_course_overview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <!-- 空状态：与周课表的「暂无课程」保持同一套视觉 -->
                <LinearLayout
                    android:id="@+id/ll_overview_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="top|center_horizontal"
                    android:paddingTop="56dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_mtrl_calendar_month"
                        android:alpha="0.3"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_overview_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="本学期暂无课程"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 回到本周：只在本周之外的周课表显示，箭头指向本周（更早 → 右箭头，更晚 → 左箭头）；
         总课表模式下随 viewPager 一起隐藏。放在 overlay_loading 之前，加载遮罩会盖住它 -->
    <com.cherry.wakeupschedule.ui.widget.CircleIconButton
        android:id="@+id/btn_back_to_week"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_arrow_right"
        android:contentDescription="回到本周"
        android:visibility="gone" />

    <!-- 课表加载遮罩：全页覆盖；背景直接用底部导航栏同款色（浅色 #DDE4ED / 深色 #0D1117），
         与导航栏连成一片无缝表面，消除硬边界；阻断页面点击 -->
    <FrameLayout
        android:id="@+id/overlay_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bottom_nav_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="28dp"
                        android:paddingVertical="20dp">

                        <!-- 加载中：转圈 + 文案 -->
                        <LinearLayout
                            android:id="@+id/group_loading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:indeterminate="true"
                                app:indicatorColor="?attr/colorPrimary"
                                app:indicatorSize="32dp"
                                app:trackThickness="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="正在加载课表…"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 加载成功：对勾 + 结果文案（短暂展示后自动收起） -->
                        <LinearLayout
                            android:id="@+id/group_success"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/ic_check"
                                android:contentDescription="@null"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/tv_load_result"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="成功导入 0 门课程"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>
