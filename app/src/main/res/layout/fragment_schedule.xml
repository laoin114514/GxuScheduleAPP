<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_schedule_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Header bar: date + week info -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_week_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第5周 (本周)"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2026/7/28"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <com.cherry.wakeupschedule.ui.widget.CircleIconButton
                android:id="@+id/btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_mtrl_refresh"
                android:contentDescription="刷新课表">

                <!-- 刷新中的小转圈（覆盖在刷新图标上） -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_refresh"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="?attr/colorPrimary"
                    app:indicatorSize="20dp"
                    app:trackThickness="2dp" />
            </com.cherry.wakeupschedule.ui.widget.CircleIconButton>

            <com.cherry.wakeupschedule.ui.widget.CircleIconButton
                android:id="@+id/btn_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_mtrl_menu"
                android:contentDescription="课表菜单" />

        </LinearLayout>

        <!-- Date header table: weekday + date, full width -->
        <LinearLayout
            android:id="@+id/layout_date_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Weekday row -->
            <LinearLayout
                android:id="@+id/header_weekdays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Offset column for time axis -->
                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_year_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="年"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <TextView android:id="@+id/tv_weekday_1" style="@style/DateHeaderText"
                    android:layout_weight="1" android:text="一" />
                <TextView android:id="@+id/tv_weekday_2" style="@style/DateHeaderText"
                    android:layout_weight="1" android:text="二" />
                <TextView android:id="@+id/tv_weekday_3" style="@style/DateHeaderText"
                    android:layout_weight="1" android:text="三" />
                <TextView android:id="@+id/tv_weekday_4" style="@style/DateHeaderText"
                    android:layout_weight="1" android:text="四" />
                <TextView android:id="@+id/tv_weekday_5" style="@style/DateHeaderText"
                    android:layout_weight="1" android:text="五" />
                <TextView android:id="@+id/tv_weekday_6" style="@style/DateHeaderText"
                    android:layout_weight="1" android:text="六" />
                <TextView android:id="@+id/tv_weekday_7" style="@style/DateHeaderText"
                    android:layout_weight="1" android:text="日" />

            </LinearLayout>

            <!-- Date number row -->
            <LinearLayout
                android:id="@+id/header_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <!-- Year in offset column -->
                <TextView
                    android:id="@+id/tv_year_value"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="2026"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView android:id="@+id/tv_date_1" style="@style/DateNumberText"
                    android:layout_weight="1" android:text="7/6" />
                <TextView android:id="@+id/tv_date_2" style="@style/DateNumberText"
                    android:layout_weight="1" android:text="7/7" />
                <TextView android:id="@+id/tv_date_3" style="@style/DateNumberText"
                    android:layout_weight="1" android:text="7/8" />
                <TextView android:id="@+id/tv_date_4" style="@style/DateNumberText"
                    android:layout_weight="1" android:text="7/9" />
                <TextView android:id="@+id/tv_date_5" style="@style/DateNumberText"
                    android:layout_weight="1" android:text="7/10" />
                <TextView android:id="@+id/tv_date_6" style="@style/DateNumberText"
                    android:layout_weight="1" android:text="7/11" />
                <TextView android:id="@+id/tv_date_7" style="@style/DateNumberText"
                    android:layout_weight="1" android:text="7/12" />

            </LinearLayout>

        </LinearLayout>

        <!-- ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- 课表加载遮罩：全页覆盖；背景直接用底部导航栏同款色（浅色 #DDE4ED / 深色 #0D1117），
         与导航栏连成一片无缝表面，消除硬边界；阻断页面点击 -->
    <FrameLayout
        android:id="@+id/overlay_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bottom_nav_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingHorizontal="28dp"
                        android:paddingVertical="20dp">

                        <!-- 加载中：转圈 + 文案 -->
                        <LinearLayout
                            android:id="@+id/group_loading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:indeterminate="true"
                                app:indicatorColor="?attr/colorPrimary"
                                app:indicatorSize="32dp"
                                app:trackThickness="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="正在加载课表…"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- 加载成功：对勾 + 结果文案（短暂展示后自动收起） -->
                        <LinearLayout
                            android:id="@+id/group_success"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/ic_check"
                                android:contentDescription="@null"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/tv_load_result"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="成功导入 0 门课程"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>
