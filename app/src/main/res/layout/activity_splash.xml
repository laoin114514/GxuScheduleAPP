<?xml version="1.0" encoding="utf-8"?>
<!-- 闪屏页：品牌图标 + 名称 + 副标题，居中。
     根布局由 BaseActivity.onContentChanged 统一铺当前配色的页面渐变底，
     这里不要再写死 background，深色/换配色才能自动跟随。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:id="@+id/tv_splash_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.08"
            android:text="@string/splash_tagline"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</FrameLayout>
