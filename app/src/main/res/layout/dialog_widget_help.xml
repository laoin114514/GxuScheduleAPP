<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件中心右下角「?」的弹窗内容：原来「使用说明」页与「找不到小组件」排查页的文案 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="把小组件添加到桌面"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="部分手机在系统小组件列表里找不到西大课栈，在这里可以一键添加到桌面，抬眼即可看到课程信息。\n\n一键添加依赖系统桌面的支持：vivo / iQOO 等机型的桌面会忽略应用的添加请求（点了没有反应），小米 / 红米 需要「桌面快捷方式」权限。遇到这些情况请按下面的方式手动添加。"
        android:textSize="@dimen/text_caption"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="找不到小组件？"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="3dp"
        android:text="· 检查应用是否被手机管家冻结或限制后台，解冻后重启桌面再试\n· 应用若安装在 SD 卡上，桌面将不显示小组件，请移回内部存储\n· 也可以长按桌面空白处 → 小组件 → 搜索「西大课栈」手动添加\n· 部分桌面有缓存，重启手机后小组件列表会重新加载"
        android:textSize="@dimen/text_caption"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
