<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程概览组件（官网「桌面小组件专区」2×2 款）：
     头部「今日课程 · N 门 | 周X」+ 状态卡片课程列表（已上完/进行中/下一节/未开始） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="10dp">

    <!-- 头部：左固定标签 + 右周X（与 4×2 变体同构） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日课程 · 3 门"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="周三"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 课程列表 ListView：支持上下滑动；行间距用透明 divider 实现 -->
    <ListView
        android:id="@+id/lv_today_courses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:minHeight="60dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:scrollbars="vertical"
        android:scrollbarSize="2dp"
        android:fadeScrollbars="true"
        android:scrollbarFadeDuration="500"
        android:scrollbarDefaultDelayBeforeFade="0"
        android:scrollbarStyle="insideInset"
        android:overScrollMode="never"
        android:listSelector="@android:color/transparent" />

    <!-- 空态：之前 setEmptyView 指向的 android.R.id.empty 在布局里并不存在，空态从未生效，这里补上 -->
    <TextView
        android:id="@android:id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="今天没有课程"
        android:textSize="@dimen/text_caption"
        android:textColor="@color/widget_text_secondary"
        android:visibility="gone" />

</LinearLayout>
