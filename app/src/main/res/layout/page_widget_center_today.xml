<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件中心 · 第 2 页「今日课程概览」：页头只出现一次，下方 4×2 主推 / 2×2 紧凑两张变体卡 -->
<com.cherry.wakeupschedule.ui.widget.VerticalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 页头：标题与总述不进卡片，双变体也不会重复 -->
        <TextView
            style="@style/AppSectionHeader"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:text="今日课程概览" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="今日全部课程状态（已上完/进行中/下一节/未开始），提供 4×2 双行卡与 2×2 紧凑两种尺寸。"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 主推：4×2 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppSectionCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4×2"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <include
                        android:id="@+id/preview_widget"
                        layout="@layout/widget_today_wide_preview" />

                </FrameLayout>

                <include
                    android:id="@+id/footer_add"
                    layout="@layout/widget_center_add_footer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 紧凑：2×2（与 4×2 并存，各自独立添加） -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppSectionCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2×2"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <FrameLayout
                    android:layout_width="172dp"
                    android:layout_height="172dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <include
                        android:id="@+id/preview_widget_small"
                        layout="@layout/widget_today_preview" />

                </FrameLayout>

                <include
                    android:id="@+id/footer_add_small"
                    layout="@layout/widget_center_add_footer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.cherry.wakeupschedule.ui.widget.VerticalScrollView>
