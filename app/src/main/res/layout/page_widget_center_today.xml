<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件中心 · 第 2 页「今日课程概览 4×2」（新增变体；2×2 仍在系统小组件选择器中提供） -->
<com.cherry.wakeupschedule.ui.widget.VerticalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView style="@style/AppSectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="今日课程概览"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4×2"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="今日全部课程状态（已上完/进行中/下一节/未开始），双行行卡可上下滑动查看更多。"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <include
                        android:id="@+id/preview_widget"
                        layout="@layout/widget_today_wide_preview" />

                </FrameLayout>

                <include
                    android:id="@+id/footer_add"
                    layout="@layout/widget_center_add_footer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 次变体：紧凑 2×2（与 4×2 并存，各自独立添加） -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppSectionCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="今日课程概览"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2×2"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="紧凑 2×2 版：今日全部课程状态，适合小空间桌面。"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <FrameLayout
                    android:layout_width="172dp"
                    android:layout_height="172dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <include
                        android:id="@+id/preview_widget_small"
                        layout="@layout/widget_today_preview" />

                </FrameLayout>

                <include
                    android:id="@+id/footer_add_small"
                    layout="@layout/widget_center_add_footer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.cherry.wakeupschedule.ui.widget.VerticalScrollView>
