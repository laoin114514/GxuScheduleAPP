<?xml version="1.0" encoding="utf-8"?>
<!-- 一周课程微缩矩阵的静态假数据预览：小组件选择器（previewLayout）与「小组件中心」页共用 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="周视图微缩地图"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="第3周"
            android:textSize="@dimen/text_micro"
            android:textColor="@color/widget_text_weak" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/widget_day_has"
            android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="一" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_has" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="2节" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_has" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/widget_day_has"
            android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="二" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_has" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="3节" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_has" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/widget_day_today"
            android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="三" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_today"
                android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="3节" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_today"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/widget_day_has"
            android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="四" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_has" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="2节" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_has" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/widget_day_has"
            android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="五" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_has" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="1节" android:textSize="@dimen/text_micro"
                android:textColor="@color/widget_day_text_has" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="本周共 11 节课"
        android:textSize="@dimen/text_micro"
        android:textColor="@color/widget_text_weak" />

</LinearLayout>
