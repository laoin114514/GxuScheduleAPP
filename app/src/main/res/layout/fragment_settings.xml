<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_flower_pattern"
        android:contentDescription="背景" />

    <View
        android:id="@+id/glass_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="应用设置"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_transparent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="学期与周次"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="当前学期"
                        android:textSize="16sp"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_current_semester"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2024-2025学年 第一学期"
                        android:textSize="14sp"
                        android:textColor="#4A90E2"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btn_modify_semester"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="修改"
                        android:textSize="14sp"
                        android:textColor="#4A90E2"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="默认显示周"
                        android:textSize="16sp"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_default_week"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="第1周"
                        android:textSize="14sp"
                        android:textColor="#4A90E2"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btn_modify_week"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设置"
                        android:textSize="14sp"
                        android:textColor="#4A90E2"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />

                </LinearLayout>

                <!-- 学期日期范围 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="学期日期"
                        android:textSize="14sp"
                        android:textColor="#AAAAAA" />

                    <TextView
                        android:id="@+id/tv_semester_date_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未获取"
                        android:textSize="13sp"
                        android:textColor="#4A90E2" />

                </LinearLayout>

                <!-- 学期周数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="学期周数"
                        android:textSize="14sp"
                        android:textColor="#AAAAAA" />

                    <TextView
                        android:id="@+id/tv_total_weeks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20周"
                        android:textSize="13sp"
                        android:textColor="#4A90E2" />

                </LinearLayout>

                <!-- 获取学期信息按钮 -->
                <TextView
                    android:id="@+id/btn_fetch_semester_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="从教务获取学期日期和总周数"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_transparent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="课表外观"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/btn_background_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="背景设置"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical" />

                <TextView
                    android:id="@+id/btn_clear_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="清空图片背景"
                    android:textSize="15sp"
                    android:textColor="#FF6B6B"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_button_outline_red"
                    android:gravity="start|center_vertical" />

                <TextView
                    android:id="@+id/btn_appearance_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="卡片外观设置"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical" />

                <TextView
                    android:id="@+id/btn_color_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="卡片配色"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_transparent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="时间表设置"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/btn_time_table_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="编辑时间表"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_transparent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提醒设置"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="课前提醒"
                        android:textSize="16sp"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_default_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="提前15分钟"
                        android:textSize="14sp"
                        android:textColor="#4A90E2"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btn_modify_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设置"
                        android:textSize="14sp"
                        android:textColor="#4A90E2"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btn_alarm_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="课前提醒开关"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/btn_permission_guide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="权限设置引导"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="节假日隐藏课程"
                        android:textSize="15sp"
                        android:textColor="@android:color/white" />

                    <Switch
                        android:id="@+id/switch_hide_holiday_courses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/SwitchTheme" />

                </LinearLayout>

            </LinearLayout>

            <!-- 账号管理卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_transparent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="账号管理"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/btn_bind_jwxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="绑定教务"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="个人信息"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_transparent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="数据管理"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/btn_school_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="从教务系统导入"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_import_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="从文件导入"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical" />

                <TextView
                    android:id="@+id/btn_export_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="导出课程表"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical" />

                <TextView
                    android:id="@+id/btn_clear_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="清除所有数据"
                    android:textSize="15sp"
                    android:textColor="#FF6B6B"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline_red"
                    android:gravity="start|center_vertical" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_transparent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="免责声明"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. 本应用所有课程数据均由用户自行导入或手动添加\n2. 教务系统导入功能仅供学习研究使用\n3. 所有数据均存储在本地设备上\n4. 使用本应用产生的风险由用户自行承担\n5. 应用UI设计参考了WakeUp课程表官方设计\n6. 本项目基于wakeup3.612版本进行魔改重构，遵循相同的开源原则"
                    android:textSize="12sp"
                    android:textColor="#CCFFFFFF"
                    android:lineSpacingMultiplier="1.3" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_transparent"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="关于与更新"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="接收更新提醒"
                        android:textSize="15sp"
                        android:textColor="@android:color/white" />

                    <Switch
                        android:id="@+id/switch_update_remind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/SwitchTheme" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btn_check_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="检测更新"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="关于应用"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical" />

                <TextView
                    android:id="@+id/btn_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="反馈/建议"
                    android:textSize="15sp"
                    android:textColor="@android:color/white"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="start|center_vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
