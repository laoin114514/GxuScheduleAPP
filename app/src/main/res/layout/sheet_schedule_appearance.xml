<?xml version="1.0" encoding="utf-8"?>
<!--
  「我的 → 课表外观」用的半屏悬浮面板。

  控件本身与课表菜单里内联的那一份完全同一套（view_schedule_appearance_controls.xml +
  ScheduleAppearanceControls），这里只提供：拖拽把手、固定高度的滚动容器、标题。
  这样两个入口看到的排版永远一致，不会再出现「菜单一套、面板一套」的分叉。

  根 View 的高度由 ScheduleAppearanceSheet 代码控制（初始半屏，拖把手可调），
  背景也在代码里画（24dp 顶部圆角 + colorSurfaceContainer），这里不写。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_appearance_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 拖拽把手：上下拖连续调整面板高度，轻点在「半屏/贴合内容」间切换。
         外层 36dp 触控区比 4dp 指示条好按得多。 -->
    <FrameLayout
        android:id="@+id/handle_area"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:clickable="true"
        android:contentDescription="拖动调整面板高度，点按切换半屏或贴合内容"
        android:focusable="true">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:alpha="0.32"
            android:background="@drawable/bg_drag_handle" />
    </FrameLayout>

    <!-- 标题行：与课表菜单同一规格（居中标题 + 右端关闭），钉在滚动区之上 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/menu_appearance_row"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_appearance_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭课表外观"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_appearance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <include layout="@layout/view_schedule_appearance_controls" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
