<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程概览 4×2 的行布局：彩底行卡（widget_row_*，与 2×2 同款状态底色）内
     双行排布——行1「课名 + 状态徽标 + 起时间」/ 行2「教室·节次 + 止时间」；
     字号/颜色 token 全部沿用 2×2 行样式（caption/label/micro），无新增颜色。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/course_wide_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_row_upcoming"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_wide_course_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_wide_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="@dimen/text_micro"
            android:textColor="@color/widget_badge_upcoming"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_wide_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="@dimen/text_label"
            android:textColor="@color/widget_text_secondary"
            android:fontFeatureSettings="tnum"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_wide_room"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_label"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_wide_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="@dimen/text_label"
            android:textColor="@color/widget_text_secondary"
            android:fontFeatureSettings="tnum"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
