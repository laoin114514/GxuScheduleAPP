<?xml version="1.0" encoding="utf-8"?>
<!-- 总课表条目：同一课程名的全部课程合并为一张卡。
     只展示「课程名 + 理论课/实践课标签 + 教师 + 有课周次」——具体节次/教室/时间在详情弹层里看。
     整卡可点击，弹出课程详情 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_course_overview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 头部：课程色首字头像 + 课程名 + 类型标签 + 详情箭头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/iv_course_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="课"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_course_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <!-- 「调课」标签：整教学班有教务调课记录时显示（默认 gone，显隐由 Adapter 控制）。
                 放在类型标签左侧、紧跟课程名：调课是需要留意的偶发状态，紧邻课程名更容易被扫到；
                 同时理论课/实践课标签的位置不会因调课标签有无而左右跳。
                 具体被调课的周次在详情弹层「调课周次」行里精确说明。 -->
            <TextView
                android:id="@+id/tv_adjust_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/course_adjusted_tag"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 理论课 / 实践课标签，底色与文字色在 CourseOverviewAdapter 里按类型设置 -->
            <TextView
                android:id="@+id/tv_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_chevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_mtrl_chevron_right"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 教师 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_mtrl_person"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_course_teacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/text_body_small"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 有课周次 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_mtrl_date_range"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_course_weeks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="@dimen/text_body_small"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
