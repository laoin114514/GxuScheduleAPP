<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_page_gradient">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurfaceVariant" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            
            <!-- 分区标题 -->
            <!-- <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="课表主题  "
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="6dp" /> -->


            <!-- 分区标题 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="课程格子"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="6dp" />

            <!-- 格子高度：滑块与数值胶囊共用同一设置（取值范围见 SettingsManager）。
                 标签与胶囊都在卡外，与下方「格子内容」统一成「小字标签 + 无标题卡片」；
                 胶囊留在标签行右侧，保住「点它输入精确值」的可发现性。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="格子高度"
                    android:textSize="@dimen/text_body_small"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cell_height_value"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="68dp"
                    android:textSize="@dimen/text_body_small"
                    android:textColor="?attr/colorPrimary"
                    android:textAllCaps="false"
                    android:contentDescription="点击输入精确高度"
                    app:backgroundTint="?attr/colorSurfaceContainerLowest"
                    app:cornerRadius="999dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_edit"
                    app:iconSize="14dp"
                    app:iconPadding="6dp"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/AppSectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 高度滑块：labelBehavior 关掉拖动气泡。AppSlider 样式的 withinBounds
                         会把气泡的 32dp 预留高度算进控件（轨道上方多出 46dp 空白），
                         而高度值已由上方数值胶囊实时显示，去掉气泡不丢信息。 -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_cell_height"
                        style="@style/AppSlider"
                        android:valueFrom="40"
                        android:valueTo="120"
                        android:stepSize="1"
                        android:value="68"
                        app:labelBehavior="gone" />

                    <!-- 取值范围两端标注 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="24dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="40"
                            android:textSize="@dimen/text_caption"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="120"
                            android:textSize="@dimen/text_caption"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 格子内容：课程名恒显示，只有教室/教师可关（默认均开启，见 SettingsManager）。
                 独立于「课程格子」分组，用一行小字做轻量标注（样式对齐字体大小页的说明文字）。 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="格子内容"
                android:textSize="@dimen/text_body_small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/AppSectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 显示教室 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="显示教室"
                            android:textSize="@dimen/text_subtitle"
                            android:textColor="?attr/colorOnSurface" />

                        <Switch
                            android:id="@+id/switch_show_classroom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:theme="@style/SwitchTheme" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="?attr/colorOutlineVariant"
                        android:layout_marginVertical="12dp" />

                    <!-- 显示教师 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="显示教师"
                            android:textSize="@dimen/text_subtitle"
                            android:textColor="?attr/colorOnSurface" />

                        <Switch
                            android:id="@+id/switch_show_teacher"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:theme="@style/SwitchTheme" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
