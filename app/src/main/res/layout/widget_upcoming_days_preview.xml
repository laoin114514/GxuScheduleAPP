<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="大二上"
        android:textSize="@dimen/text_body_small"
        android:textColor="@color/widget_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3.27 第4周"
        android:textSize="@dimen/text_label"
        android:textColor="@color/widget_text_secondary"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● 数据可视化"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_bar_neutral"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  5阶101"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_text_weak" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● 软件工程实验"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_bar_neutral"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  多媒体实验室"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_text_weak" />
        </LinearLayout>

        <!-- 分隔线：RemoteViews 布局白名单不允许裸 <View>，用 FrameLayout 承载（否则预览整卡 inflate 失败） -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_card_stroke"
            android:layout_marginHorizontal="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="明日"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● 数据可视化"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_bar_neutral"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  多媒体实验室"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_text_weak" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● 无人机技术"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_bar_neutral"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  实验楼203"
                android:textSize="@dimen/text_label"
                android:textColor="@color/widget_text_weak" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="近日课程"
        android:textSize="@dimen/text_label"
        android:textColor="@color/widget_text_weak"
        android:layout_marginTop="4dp" />

</LinearLayout>