<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件夜间配色：不透明近黑底（课表页深色渐变亮端 / 底部导航同色），
     文字与强调色对齐「海洋蓝」暗色调色板角色（onSurface/onSurfaceVariant/outline/primary） -->
<resources>
    <color name="widget_card_bg">#0D1117</color>
    <color name="widget_card_stroke">#1E293B</color>

    <color name="widget_text_title">#E2E2E9</color>
    <color name="widget_text_secondary">#C3C7CF</color>
    <color name="widget_text_weak">#8D9199</color>

    <color name="widget_accent">#AAC7FF</color>

    <color name="widget_day_text_has">#93C5FD</color>
    <color name="widget_day_text_empty">#8D9199</color>

    <color name="widget_pill_text_amber">#FDE68A</color>
    <color name="widget_pill_text_gray">#8D9199</color>

    <color name="widget_bar_neutral">#64748B</color>

    <!-- 缺口补齐：浅色定义了这些，夜间却漏了，深色下会取到浅色值
         （例：upcoming 徽标 #94A3B8 压在深色行卡上只有 2.34:1） -->
    <color name="widget_badge_finished">#93C5FD</color>
    <color name="widget_badge_active">#D8B4FE</color>
    <color name="widget_badge_upcoming">#CBD5E1</color>
    <color name="widget_day_text_today">#0D1117</color>
    <color name="widget_chip_room_text">#E6FFFFFF</color>
</resources>
