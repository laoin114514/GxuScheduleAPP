<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- M3 default placeholder colors (will be overridden by ThemeManager at runtime) -->
    <color name="m3_primary">#6750A4</color>
    <color name="m3_on_primary">#FFFFFF</color>
    <color name="m3_surface">#FFFBFE</color>
    <color name="m3_on_surface">#1C1B1F</color>
    <color name="m3_outline">#79747E</color>
    <color name="m3_error">#B3261E</color>

    <!-- 危险操作专用色：浅色经典红（深色下各主题 colorError 偏粉，统一用鲜艳红保证警示感） -->
    <color name="danger_color">#B3261E</color>

    <!-- 应用内提示卡语义色：成功（浅色下压暗保证在浅底上的对比度） -->
    <color name="success_color">#1E8E3E</color>
    <!-- 应用内提示卡语义色：警告（浅色下用深琥珀，避免纯黄在浅底上不可读） -->
    <color name="warn_color">#B26A00</color>

    <!-- 语义色：负向（校验失败 / 挂科 / 危险操作）。
         与 danger_color 同源，单独命名是为了让"错误提示"和"危险按钮"语义分开 -->
    <color name="semantic_negative">#B3261E</color>
</resources>
