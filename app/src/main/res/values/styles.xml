<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RoundedDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="SwitchTheme" parent="">
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
    </style>

    <!-- 日期栏沿用 7158991 的字号层级：周几 14sp（强）、日期 12sp（弱） -->
    <style name="DateHeaderText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="DateNumberText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>



    <!-- 课程详情 Bottom Sheet -->
    <style name="BottomSheetDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- 底部滑入动画 -->
    <style name="BottomSheetAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <!-- 全局页面跳转动画：经典水平右滑（新页从右滑入，返回时右滑退出） -->
    <style name="AppWindowAnimations" parent="android:Animation">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <!-- 紧凑型底部导航：缩小图标/内边距/字号，减少纵向占用（默认 80dp → 52dp） -->
    <style name="BottomNavCompact" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">52dp</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemPaddingTop">5dp</item>
        <item name="itemPaddingBottom">5dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Material3.LabelSmall</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Material3.LabelSmall</item>
    </style>

    <!-- 全局内容区块卡片（统一课表玻璃卡质感） -->


<!-- ===== 我的 / 设置系列页面：与工具页统一的设计语言 ===== -->

<!-- 分组卡片：24dp 大圆角、无描边、1dp 软阴影（对齐工具页卡片） -->
<style name="AppSectionCard" parent="Widget.Material3.CardView.Elevated">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="cardCornerRadius">@dimen/radius_xl</item>
    <item name="cardElevation">1dp</item>
    <!-- 浅色 0dp / 深色 1dp（见 values-night/dimens.xml） -->
    <item name="strokeWidth">@dimen/card_stroke_width</item>
    <item name="strokeColor">?attr/colorOutlineVariant</item>
    <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
</style>

<!-- 卡片外分组标题（对齐工具页的分组标题） -->
<style name="AppSectionHeader">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">@dimen/text_title</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:paddingStart">4dp</item>
    <item name="android:paddingTop">22dp</item>
    <item name="android:paddingBottom">10dp</item>
</style>

<!-- 详情页 Toolbar 标题：居中、主色、加粗（与一级页顶栏同号 20sp）。
     之前一级页 20sp、二级页 18sp，同一层级差 2sp，肉眼像"没对齐"却说不清哪里不对。 -->
<style name="AppToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textSize">@dimen/text_headline</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorPrimary</item>
</style>

<!-- 弹层（课程详情 / 课表菜单）内部卡片：大圆角、无描边（对齐工具页语言） -->
<style name="DetailSheetCard" parent="Widget.Material3.CardView.Elevated">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="cardCornerRadius">20dp</item>
    <item name="cardElevation">0dp</item>
    <item name="strokeWidth">0dp</item>
    <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    <item name="contentPadding">0dp</item>
</style>

<!-- 底部弹层的分组标签（「周次」/「学期」）：小号 + 加粗 + 低对比度。
     不用主色：主色小字在浅色底上读起来像可点链接，与下面真正可点的卡片抢注意力。 -->
<style name="SheetSectionLabel">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">@dimen/text_body_small</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    <item name="android:letterSpacing">0.04</item>
</style>

<!-- 全局滑块：白色圆球 + 细轨道（课表菜单周数 / 字体大小共用）。
     旧版是「轨道 20dp + 拇指 18dp」——拇指比轨道还细，白球埋在粗条里，
     拖动时看不出抓取点，离散刻度也被轨道盖住。现在拇指 20dp > 轨道 4dp，
     刻度点恢复可见。 -->
<style name="AppSlider" parent="Widget.Material3.Slider">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="labelBehavior">withinBounds</item>
    <item name="thumbColor">#FFFFFF</item>
    <item name="thumbWidth">20dp</item>
    <item name="thumbHeight">20dp</item>
    <item name="thumbRadius">10dp</item>
    <item name="thumbStrokeColor">?attr/colorPrimary</item>
    <item name="thumbStrokeWidth">2dp</item>
    <item name="thumbElevation">4dp</item>
    <item name="trackColorActive">?attr/colorPrimary</item>
    <item name="trackColorInactive">?attr/colorOutlineVariant</item>
    <item name="trackHeight">4dp</item>
    <item name="tickVisible">true</item>
    <item name="tickColorActive">?attr/colorOnPrimary</item>
    <item name="tickColorInactive">?attr/colorOutline</item>
    <item name="tickRadiusActive">2dp</item>
    <item name="tickRadiusInactive">1.5dp</item>
</style>
</resources>