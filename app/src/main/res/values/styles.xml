<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RoundedDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="SwitchTheme" parent="">
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
    </style>

    <style name="DateHeaderText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="DateNumberText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="ProfileSection" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">4dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- 课程详情 Bottom Sheet -->
    <style name="BottomSheetDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- 底部滑入动画 -->
    <style name="BottomSheetAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <!-- 全局页面跳转动画：经典水平右滑（新页从右滑入，返回时右滑退出） -->
    <style name="AppWindowAnimations" parent="android:Animation">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <!-- 紧凑型底部导航：缩小图标/内边距/字号，减少纵向占用（默认 80dp → 52dp） -->
    <style name="BottomNavCompact" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">52dp</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemPaddingTop">5dp</item>
        <item name="itemPaddingBottom">5dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Material3.LabelSmall</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Material3.LabelSmall</item>
    </style>

    <!-- 全局内容区块卡片（统一课表玻璃卡质感） -->
    <style name="ScheduleSectionCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">4dp</item>
    </style>


<!-- ===== 我的 / 设置系列页面：与工具页统一的设计语言 ===== -->

<!-- 分组卡片：24dp 大圆角、无描边、1dp 软阴影（对齐工具页卡片） -->
<style name="AppSectionCard" parent="Widget.Material3.CardView.Elevated">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="cardCornerRadius">24dp</item>
    <item name="cardElevation">1dp</item>
    <item name="strokeWidth">0dp</item>
    <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
</style>

<!-- 卡片外分组标题（对齐工具页的分组标题） -->
<style name="AppSectionHeader">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:paddingStart">4dp</item>
    <item name="android:paddingTop">22dp</item>
    <item name="android:paddingBottom">10dp</item>
</style>

<!-- 详情页 Toolbar 标题：居中、主色、加粗（对齐工具页顶栏标题） -->
<style name="AppToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorPrimary</item>
</style>

<!-- 弹层（课程详情 / 课表菜单）内部卡片：大圆角、无描边（对齐工具页语言） -->
<style name="DetailSheetCard" parent="Widget.Material3.CardView.Elevated">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="cardCornerRadius">20dp</item>
    <item name="cardElevation">0dp</item>
    <item name="strokeWidth">0dp</item>
    <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    <item name="contentPadding">0dp</item>
</style>
</resources>