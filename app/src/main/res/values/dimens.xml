<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 课程格子「默认」高度：实际高度可在「我的 → 外观 → 课表」里调（40–120dp）。
         这里只作为从未设置过时的默认值，改这里即改默认；用户调过之后以设置值为准。 -->
    <dimen name="course_cell_height">68dp</dimen>
    <dimen name="card_elevation_normal">1dp</dimen>
    <dimen name="card_elevation_highlight">12dp</dimen>

    <!--
      全局字号刻度（统一入口）。
      数值用 sp，因此会随系统字体缩放与 App 内 UI 缩放档位（改 densityDpi）一同变化。
      布局里一律引用这里，不要再写死 android:textSize="NNsp"；
      代码里取 px 用 resources.getDimension(...) + setTextSize(COMPLEX_UNIT_PX, ...)。
    -->
    <dimen name="text_display">24sp</dimen>      <!-- 页面超大标题 -->
    <dimen name="text_headline">20sp</dimen>     <!-- 区块大标题 -->
    <dimen name="text_title">18sp</dimen>        <!-- 分组标题 / 卡片标题 -->
    <dimen name="text_subtitle">16sp</dimen>     <!-- 主要正文 / 按钮 -->
    <dimen name="text_body">15sp</dimen>         <!-- 常规正文 / 设置项名 -->
    <dimen name="text_body_small">14sp</dimen>   <!-- 次要正文 / 说明 -->
    <dimen name="text_caption">12sp</dimen>      <!-- 辅助说明 / 值 -->
    <dimen name="text_label">10sp</dimen>        <!-- 极小标签 / 课程卡片 -->
    <dimen name="text_micro">10sp</dimen>        <!-- widget 专用小字（原 9sp，桌面上一眼读不出） -->
    <dimen name="text_chip_room">10sp</dimen>    <!-- widget 课程块教室行（原 8sp，低于可读下限） -->

    <!-- 课程格子内文字：课名 11sp / 教室·教师 10sp。
         格子宽度只有约 50dp（360dp 屏），10sp 的课名只能摆 4–5 个字，
         所以课名固定 11sp + 最多 3 行截断，元信息 10sp 退一档（见 UI 方案 §3.2）。 -->
    <dimen name="text_course_cell">11sp</dimen>
    <dimen name="text_course_cell_meta">10sp</dimen>

    <!-- 课表左侧时间轴列宽：32dp 装 "08:00"(10sp ≈ 25dp) 只剩 4dp 余量，
         系统字体放大就折行；加到 40dp 并把文字居中，左边距约 7dp -->
    <dimen name="time_axis_width">40dp</dimen>

    <!-- 时间轴上的开始时间（课名下方的小字） -->
    <dimen name="text_time_axis">10sp</dimen>

    <!-- ===== 布局令牌（UI 方案 §3.3） =====
         页面边距/卡内边距/行间距统一走这里，别再各写各的：
         之前全 App 并存 16 / 20 / 24 三套页面边距，工具页内部还有 24/20/16 三条左边缘。 -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>
    <dimen name="space_2xl">24dp</dimen>
    <dimen name="space_3xl">32dp</dimen>

    <!-- 页面横向边距：一级页与二级页统一 20dp -->
    <dimen name="page_margin">20dp</dimen>
    <!-- 卡片内边距：统一 16dp -->
    <dimen name="card_padding">16dp</dimen>

    <!-- 圆角令牌：原实际使用的圆角有 2/4/5/8/12/14/16/18/20/24/28/999 共 12 档 -->
    <dimen name="radius_xs">4dp</dimen>      <!-- 色棒 / 徽标 -->
    <dimen name="radius_sm">8dp</dimen>      <!-- 输入框 / 课程格子 -->
    <dimen name="radius_md">12dp</dimen>     <!-- 行卡 / 内联提示 -->
    <dimen name="radius_lg">16dp</dimen>     <!-- 组件卡 -->
    <dimen name="radius_xl">24dp</dimen>     <!-- 页面分组卡 / 弹层顶角 -->
    <dimen name="radius_full">999dp</dimen>  <!-- 胶囊 -->

    <!-- 所有页面顶部栏统一高度（原来一级页写死 52dp、二级页用 ?attr/actionBarSize ≈ 56dp） -->
    <dimen name="top_bar_height">52dp</dimen>

    <!-- 卡片描边：浅色下面卡片靠白底 + 1dp 阴影就能分辨，深色下必须靠描边 -->
    <dimen name="card_stroke_width">0dp</dimen>
</resources>
