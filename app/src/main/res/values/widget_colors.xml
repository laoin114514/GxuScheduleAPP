<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件配色 token。
  小组件布局由桌面进程以本 App 资源渲染，night 限定符跟随系统深色模式；
  代码里 setTextColor 等动态取色一律 context.getColor(R.color.widget_*)，不再有第二套入口。
  2026-10：卡片背景改为不透明并取课表页渐变亮端色（= 底部导航同色），
  文字/强调色对齐应用主题「海洋蓝」调色板的角色色（onSurface/onSurfaceVariant/
  outline/primary；调色板当前不可被用户切换，故直接写死）。
-->
<resources>
    <!-- 容器卡片：不透明，课表页渐变亮端色（浅 #C4D4E4→#DDE4ED 的末端） -->
    <color name="widget_card_bg">#DDE4ED</color>
    <color name="widget_card_stroke">#0F000000</color>

    <!-- 文字三级：标题 / 次要 / 弱化（onSurface / onSurfaceVariant / outline） -->
    <color name="widget_text_title">#1A1C1E</color>
    <color name="widget_text_secondary">#43474E</color>
    <color name="widget_text_weak">#73777F</color>

    <!-- 主强调（倒计时数字、当日高亮）：主题 primary -->
    <color name="widget_accent">#1565C0</color>

    <!-- 今日概览状态行文字：
         彩色状态行（未开始/下一节/进行中）= 课表页课程卡同款白字（次要行 70% 白）；
         「已上完」灰卡连标题带次要行一起灰掉，扫视时主动退到背景里 -->
    <color name="widget_status_text">#FFFFFFFF</color>
    <color name="widget_status_text_weak">#B3FFFFFF</color>
    <color name="widget_status_finished_text">#7B838D</color>
    <color name="widget_status_finished_text_weak">#98A0A9</color>

    <!-- 周矩阵日期格文字色（无课日标签 = outline） -->
    <color name="widget_day_text_today">#FFFFFF</color>
    <color name="widget_day_text_has">#1E40AF</color>
    <color name="widget_day_text_empty">#73777F</color>

    <!-- 下一门课提醒的时间徽标 -->
    <color name="widget_pill_text_amber">#92400E</color>
    <color name="widget_pill_text_gray">#73777F</color>

    <!-- 下一门课提醒的课程行竖线：无课/失败占位的中性灰（课程态用课表页课程色，不随主题） -->
    <color name="widget_bar_neutral">#94A3B8</color>

    <!-- 周视图课程块教室行文字（白 70%，主题无关） -->
    <color name="widget_chip_room_text">#B3FFFFFF</color>
</resources>
