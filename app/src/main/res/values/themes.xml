<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base M3 theme -->
    <style name="Theme.WakeupSchedule" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Opt out of edge-to-edge on Android 15+ -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 统一页面跳转动画，缩短系统默认转场的迟滞感 -->
        <item name="android:windowAnimationStyle">@style/AppWindowAnimations</item>
    </style>

