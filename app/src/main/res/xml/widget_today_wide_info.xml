<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程概览 4×2 变体的小组件信息：与 2×2 的 widget_today_info.xml 并存 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today_schedule_wide"
    android:previewLayout="@layout/widget_today_wide_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_today_wide_description" />
