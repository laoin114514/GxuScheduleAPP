# ==================== 服务 ====================
# 容器内监听端口固定 8080（被 compose 里的 environment 覆盖），
# 集群外暴露的宿主端口由 HOST_PORT 控制。
SERVER_PORT=8080
HOST_PORT=8080
APP_ENV=production

# 上传接口 API Key。必须与 GitHub Actions secrets 中的 UPDATE_SERVER_API_KEY 一致。
# 建议生成方式: openssl rand -hex 32
UPLOAD_API_KEY=please-change-me-to-a-long-random-string

# ==================== 数据库 ====================
# 默认由 docker-compose 起一个 MySQL 容器（服务名 mysql），库名/账号/密码就用下面这几项：
#   DB_NAME 会被建成库；DB_USER=root 时沿用镜像的 root，否则自动另建该账号并授权。
# 以下三行仅在使用外部实例（如阿里云 RDS）时生效，需要自己建库建用户。
# 用外部实例时在下面补 COMPOSE_DB_HOST=<RDS 地址>（compose 会覆盖容器内的 DB_HOST），
# 并只起 app：docker compose up -d --no-deps app；RDS 白名单需放行服务器 IP。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=schedule
DB_USER=schedule
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
# 外部实例地址（留空则容器内连 compose 的 mysql 服务）
# COMPOSE_DB_HOST=rm-xxxx.mysql.rds.aliyuncs.com
# MySQL 映射到宿主的端口，3306 被占用时可改（仅影响宿主直连，不影响容器内 app）
# MYSQL_HOST_PORT=3306

# ==================== 阿里云 OSS ====================
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 预签名 URL 有效期（秒），仅 CDN_BASE_URL 留空时使用
OSS_SIGN_EXPIRE_SECONDS=3600

# ==================== 下载地址 ====================
# 非空：下载地址 = CDN_BASE_URL + "/" + OSS key（要求桶公共读或 CDN 回源可读）
# 留空：返回 OSS 预签名 URL（桶私有场景）
CDN_BASE_URL=
# 比如 CDN_BASE_URL=https://cdn.your-domain.com

# ==================== 行为开关 ====================
# 单次上传最大体积（MB）
MAX_UPLOAD_MB=512
# 允许发布低于当前最新 versionCode 的包（回滚），默认 false 拒绝
ALLOW_DOWNGRADE=false
# 最新版查询接口的每 IP 限流
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10
