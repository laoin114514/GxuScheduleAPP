# ==================== 服务 ====================
# 容器内监听端口固定 8080（被 compose 里的 environment 覆盖），
# 集群外暴露的宿主端口由 HOST_PORT 控制。
SERVER_PORT=8080
HOST_PORT=8080
APP_ENV=production

# 上传接口 API Key。必须与 GitHub Actions secrets 中的 UPDATE_SERVER_API_KEY 一致。
# 建议生成方式: openssl rand -hex 32
UPLOAD_API_KEY=please-change-me-to-a-long-random-string

# ==================== 数据库 ====================
# docker-compose 会引用 DB_* / MYSQL_ROOT_PASSWORD 创建 MySQL 容器
DB_HOST=mysql
DB_PORT=3306
DB_NAME=schedule
DB_USER=schedule
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DB_CHARSET=utf8mb4

# ==================== 阿里云 OSS ====================
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 预签名 URL 有效期（秒），仅 CDN_BASE_URL 留空时使用
OSS_SIGN_EXPIRE_SECONDS=3600

# ==================== 下载地址 ====================
# 非空：下载地址 = CDN_BASE_URL + "/" + OSS key（要求桶公共读或 CDN 回源可读）
# 留空：返回 OSS 预签名 URL（桶私有场景）
CDN_BASE_URL=
# 比如 CDN_BASE_URL=https://cdn.your-domain.com

# ==================== 行为开关 ====================
# 单次上传最大体积（MB）
MAX_UPLOAD_MB=512
# 允许发布低于当前最新 versionCode 的包（回滚），默认 false 拒绝
ALLOW_DOWNGRADE=false
# 最新版查询接口的每 IP 限流
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10
