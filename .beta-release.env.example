# 西大课栈 · 本地测试版发布配置（示例）
#
# 复制为 .beta-release.env 后填入真实值；该文件已被 .gitignore 忽略。
# 也可以直接运行 `python3 scripts/beta_release.py --init-signing` 自动生成。

# 更新服务地址（正式版与测试版共用同一个服务；本地脚本只会上传 schedule-beta 渠道）
UPDATE_BASE_URL=https://easo.laoin.work/schedule

# 上传 key（必填）：schedule-beta 渠道的专属 upload key，形如 gxu_live_<keyId>_<43字符>。
# - 新方案下每个 app 有自己的 key，服务端只存 SHA-256，明文只在 admin API 签发/轮换时返回一次；
# - 测试版必须用 schedule-beta 渠道的 key（正式渠道 schedule 的 key 会被 APP_KEY_MISMATCH 拒绝）；
# - 获取方式（ADMIN_API_KEY 只放管理员本机，不要写进本文件、更不要进 CI）：
#     curl -sS -X POST "$UPDATE_BASE_URL/api/v1/admin/apps/schedule-beta/keys" \
#       -H "Authorization: Bearer $ADMIN_API_KEY"
#   把响应 data.plaintext 填到下面；首次使用若 app 尚未创建，见
#   docs/测试版构建与发布.md §2.2。
UPDATE_API_KEY=

# 测试版渠道 appKey（与 app/build.gradle 的 beta build type 一致）
BETA_APP_KEY=schedule-beta

# 测试版签名文件（相对仓库根目录或绝对路径；生成后必须离线备份）
BETA_STORE_FILE=wakeup-schedule-beta-key.jks
BETA_STORE_PASSWORD=
BETA_KEY_ALIAS=beta
BETA_KEY_PASSWORD=
